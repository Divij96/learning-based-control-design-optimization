<?xml version="1.0"?>
<robot name="simple_3dof_arm">

  <!-- Define blue color for the links -->
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Ground link (fixed base link) -->
  <link name="ground_link">
    <!-- No visual or collision properties needed for the ground link -->
  </link>

  <!-- Fixed joint connecting ground to the base_link -->
  <joint name="fixed_base" type="fixed">
    <parent link="ground_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- First link -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <cylinder length="1.0" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Revolute joint connecting base_link to link_1 -->
  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1000.0" velocity="1.0"/>
  </joint>

  <!-- Second link -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <cylinder length="1.0" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Revolute joint connecting link_1 to link_2 -->
  <joint name="joint_2" type="revolute">
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1000.0" velocity="1.0"/>
  </joint>

  <!-- Third link -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.8" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Revolute joint connecting link_2 to link_3 -->
  <joint name="joint_3" type="revolute">
    <origin xyz="0 1.0 0" rpy="0 0 0"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1000.0" velocity="1.0"/>
  </joint>

</robot>
